//! #include "uniformsCompute.glsl"
//! #include "milkyWaySky.glsl"

// Terrain adapted from Inigo Quilez / Ignacio CP Shadertoy (MdX3Rr)
// Geometry + surface color only. Coordinates remapped to ORKA Z-up (XY ground).
// SC stays at the original 250. WORLD_DIV maps Shadertoy lengths into ORKA units
// (orka = shadertoy / WORLD_DIV) — adjust WORLD_DIV to change overall size.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D colorImage;
layout(binding = 1) uniform sampler2D iChannel0;
layout(binding = 2) uniform sampler2D iChannel2;

struct Point
{
	vec4 worldPos; // planet: xyz=flat/world pos, w=1; sky: xyz=view dir, w=0
	vec4 color;
};

layout(std430, binding = 1) buffer PointCloud
{
	Point points[];
};

const float SC = 250.0;
const float WORLD_DIV = 2500.0;
const float ST = WORLD_DIV / SC;                 // Shadertoy→ORKA length scale
const float INV_WORLD = 1.0 / WORLD_DIV;
const float HEIGHT_AMP = SC * 100.0 * INV_WORLD; // terrain height scale
const float TERRAIN_Z_OFFSET = 15.0; // measured cam height at (0,0) ground contact
const mat2 m2 = mat2(0.8, -0.6, 0.6, 0.8);
const float terrainFreq = 0.0032 * ST;           // freq * (WORLD_DIV / SC)
const float modi = 0.05;
const vec3 SUN_COL = vec3(7.0, 5.0, 3.0);
const int MAX_MARCH_STEPS = 512;

// Mooncrash planet curvature (terrain.vert / mooncrashVertexColor.vert)
float planetRadius()
{
	return pow(2.0, worldOffset.w);
}

// Horizontal arc distance in planet radii (dist >= 0)
float planetDist(vec3 rel, float R)
{
	return 1.5 * length(rel.xy) / R;
}

float planetFunc(float dist)
{
	return sqrt(1.0 - min(dist * dist, 1.0));
}

bool beyondHorizon(vec3 rel)
{
	return planetDist(rel, planetRadius()) > 1.0;
}

// Horizontal planet disc radius (matches beyondHorizon / Mooncrash 1.5 factor).
float planetHorizonRadius()
{
	return planetRadius() / 1.5;
}

// Clamp march distance to the planet disc so rays can't run out to infinity.
float clampTmaxToPlanet(vec3 rd, float tmax)
{
	float maxHoriz = planetHorizonRadius();
	float hs = length(rd.xy);
	if (hs > 1e-6)
		return min(tmax, 0.999 * maxHoriz / hs);
	// Straight up/down: no horizon in XY — keep a bounded sky distance.
	return min(tmax, planetRadius());
}

vec3 flatRelativeFromCurved(vec3 rel)
{
	float R    = planetRadius();
	float func = planetFunc(planetDist(rel, R));
	rel.z     -= (func - 1.0) * R;
	return rel;
}

vec3 flatWorldPos(vec3 worldPos)
{
	vec3 rel = worldPos - cameraPosition.xyz;
	if (beyondHorizon(rel)) return worldPos;
	return cameraPosition.xyz + flatRelativeFromCurved(rel);
}

void transformNormalToCurved(vec3 rel, inout vec3 normal)
{
	float R    = planetRadius();
	float func = planetFunc(planetDist(rel, R));
	vec3 newZ  = normalize(vec3(rel.xy * 2.0, func * R));
	vec3 newX  = normalize(cross(vec3(0.0, 1.0, 0.0), newZ));
	vec3 newY  = normalize(cross(newZ, newX));
	normal     = normal.x * newX + normal.y * newY + normal.z * newZ;
}

vec3 noised(in vec2 x)
{
	vec2 p = floor(x);
	vec2 f = fract(x);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = textureLod(iChannel0, (p + 0.5) / 256.0, 0.0).x;
	float b = textureLod(iChannel0, (p + vec2(1.5, 0.5)) / 256.0, 0.0).x;
	float c = textureLod(iChannel0, (p + vec2(0.5, 1.5)) / 256.0, 0.0).x;
	float d = textureLod(iChannel0, (p + 1.5) / 256.0, 0.0).x;
	vec2  ba_ca = vec2(b - a, c - a);
	float abcd  = a - b - c + d;
	return vec3(
		a + ba_ca.x * u.x + ba_ca.y * u.y + abcd * u.x * u.y,
		6.0 * f * (1.0 - f) * (ba_ca + abcd * u.yx)
	);
}

float detailH(in vec2 x)
{
	// Sample as at x*WORLD_DIV in Shadertoy space, then scale amplitude
	return 0.5 * INV_WORLD * textureLod(iChannel2, x * (2.0 * ST), 0.0).x;
}

float terrainN(in vec2 x, int octaves)
{
	vec2  p = x * terrainFreq;
	float a = 0.0;
	float b = 1.0;
	vec2  d = vec2(0.0);
	float intensity = 1.2;
	for (int i = 0; i < octaves; i++)
	{
		vec3 n = noised(p) * intensity;
		if (i == 0) intensity = n.x + modi;
		d += n.yz;
		a += b * n.x / (1.0 + dot(d, d));
		b *= 0.5;
		p = m2 * p * 2.0;
	}
	return HEIGHT_AMP * a - detailH(x) - TERRAIN_Z_OFFSET;
}

float terrainH(in vec2 x) { return terrainN(x, 15); }
float terrainM(in vec2 x) { return terrainN(x, 9); }

float sdSphere(vec3 p, vec3 center, float radius)
{
	return length(p - center) - radius;
}

float sdBox(vec3 p, vec3 b)
{
	vec3 q = abs(p) - b;
	return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float terrainSDF(vec3 p)
{
	return p.z - terrainM(p.xy);
}

float objectsSDF(vec3 p)
{
	return min(
		min(sdBox(p, vec3(1.0)), sdSphere(p, vec3(0.0, 3.0, 1.0), 1.0)),
		sdSphere(p, vec3(1.0, 3.0, 0.5), 1.0)
	) - 0.01;
}

float scene(vec3 p)
{
	return min(terrainSDF(p), objectsSDF(p));
}

float sceneCurved(vec3 worldPos)
{
	if (!bool(customInt1)) return scene(worldPos);

	vec3 rel = worldPos - cameraPosition.xyz;
	if (beyondHorizon(rel)) return 1000.0;
	return scene(flatWorldPos(worldPos));
}

float fbm(vec2 p)
{
	float f = 0.0;
	f += 0.5000 * textureLod(iChannel0, p / 256.0, 0.0).x; p = m2 * p * 2.02;
	f += 0.2500 * textureLod(iChannel0, p / 256.0, 0.0).x; p = m2 * p * 2.03;
	f += 0.1250 * textureLod(iChannel0, p / 256.0, 0.0).x; p = m2 * p * 2.01;
	f += 0.0625 * textureLod(iChannel0, p / 256.0, 0.0).x;
	return f / 0.9375;
}

float intersectScene(in vec3 ro, in vec3 rd, in float tmin, in float tmax, out int steps)
{
	float t = tmin;
	steps = 0;
	for (int i = 0; i < MAX_MARCH_STEPS; i++)
	{
		steps = i + 1;
		float h = sceneCurved(ro + t * rd);
		if (h < (0.001 * t) || t > tmax) break;
		t += 0.5 * h;
	}
	return t;
}

vec3 stepCountColor(int steps)
{
	float n = clamp(float(steps) / float(MAX_MARCH_STEPS), 0.0, 1.0);
	vec3 low  = vec3(0.05, 0.10, 0.85);
	vec3 mid  = vec3(0.10, 0.90, 0.35);
	vec3 high = vec3(0.95, 0.15, 0.05);
	vec3 col  = mix(low, mid, smoothstep(0.0, 0.5, n));
	col       = mix(col, high, smoothstep(0.5, 1.0, n));
	return pow(col, vec3(0.4545));
}

float softShadow(in vec3 ro, in vec3 rd)
{
	float res = 1.0;
	float t = 0.001 * INV_WORLD;
	for (int i = 0; i < 80; i++)
	{
		float h = scene(ro + t * rd);
		res = min(res, 16.0 * h / t);
		t += h;
		if (res < 0.001 || t > 2.0 * HEIGHT_AMP) break; // (SC * 200) / WORLD_DIV
	}
	return clamp(res, 0.0, 1.0);
}

vec3 calcTerrainNormal(in vec3 pos, float t)
{
	vec2 eps = vec2(0.002 * t, 0.0);
	return normalize(vec3(
		terrainH(pos.xy - eps.xy) - terrainH(pos.xy + eps.xy),
		terrainH(pos.xy - eps.yx) - terrainH(pos.xy + eps.yx),
		2.0 * eps.x
	));
}

vec3 calcObjectNormal(in vec3 pos)
{
	const vec2 e = vec2(0.001, 0.0);
	return normalize(vec3(
		objectsSDF(pos + e.xyy) - objectsSDF(pos - e.xyy),
		objectsSDF(pos + e.yxy) - objectsSDF(pos - e.yxy),
		objectsSDF(pos + e.yyx) - objectsSDF(pos - e.yyx)
	));
}

vec3 pixelRayDirection(ivec2 pixel, ivec2 size)
{
	vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;

	mat4 invVP = inverse(pMatrix * vMatrix);
	vec4 nearH = invVP * vec4(ndc, 0.0, 1.0);
	vec4 farH  = invVP * vec4(ndc, 1.0, 1.0);
	return normalize(farH.xyz / farH.w - nearH.xyz / nearH.w);
}

vec3 shadeHit(in vec3 ro, in vec3 rd, float t, float tmax, vec3 light1)
{
	vec3 col;

	if (t > tmax)
		return milkyWaySky(rd);

	vec3 pos     = ro + t * rd;
	vec3 flatPos = bool(customInt1) ? flatWorldPos(pos) : pos;
	bool hitTerrain = terrainSDF(flatPos) <= objectsSDF(flatPos);

	if (hitTerrain)
	{
		vec3 nor = calcTerrainNormal(flatPos, t);
		if (bool(customInt1)) transformNormalToCurved(pos - cameraPosition.xyz, nor);
		vec3 ref = reflect(rd, nor);
		float fre = clamp(1.0 + dot(rd, nor), 0.0, 1.0);
		float fre4 = fre * fre * fre * fre;

		float r = textureLod(iChannel0, (7.0 * ST) * flatPos.xy / 256.0, 0.0).x;
		col = mix(0.75, 1.0, r) * 0.9 * mix(
			vec3(0.08, 0.05, 0.03),
			vec3(0.10, 0.09, 0.08),
			textureLod(iChannel0, 0.00007 * ST * vec2(flatPos.x, (flatPos.z + TERRAIN_Z_OFFSET) * 48.0), 0.0).x
		);
		col = mix(col, 0.20 * vec3(0.45, 0.30, 0.15) * mix(0.50, 1.0, r), smoothstep(0.70, 0.9, nor.z));
		col = mix(col, 0.15 * vec3(0.30, 0.30, 0.10) * mix(0.25, 1.0, r), smoothstep(0.95, 1.0, nor.z));

		float h = smoothstep(55.0, 80.0, (flatPos.z + TERRAIN_Z_OFFSET) * ST + 25.0 * fbm(0.01 * flatPos.xy * ST));
		float e = smoothstep(1.0 - 0.5 * h, 1.0 - 0.1 * h, nor.z);
		float o = mix(0.3, 1.0, smoothstep(0.0, 0.1, nor.x + h * h));
		float s = h * e * o;
		col = mix(col, 0.29 * vec3(0.62, 0.65, 0.7), smoothstep(0.1, 0.9, s));

		float amb = clamp(0.5 + 0.5 * nor.z, 0.0, 1.0);
		float dif = clamp(dot(light1, nor), 0.0, 1.0);
		float bac = clamp(0.2 + 0.8 * dot(normalize(vec3(-light1.xy, 0.0)), nor), 0.0, 1.0);
		float sh = 1.0;
		if (dif >= 0.0001) sh = softShadow(flatPos + light1 * (20.0 * INV_WORLD), light1);

		vec3 lin = vec3(0.0);
		lin += dif * SUN_COL * vec3(sh, sh * sh * 0.5 + 0.5 * sh, sh * sh * 0.8 + 0.2 * sh);
		lin += amb * vec3(0.40, 0.60, 0.80) * 1.2;
		lin += bac * vec3(0.40, 0.50, 0.60);
		col *= lin;

		float spec = s * 0.1 * fre4;
		col += spec * SUN_COL * sh * pow(clamp(dot(light1, ref), 0.0, 1.0), 16.0);
		col += spec * vec3(0.4, 0.5, 0.6) * smoothstep(0.0, 0.6, ref.z);
	}
	else
	{
		vec3 nor = calcObjectNormal(flatPos);
		if (bool(customInt1)) transformNormalToCurved(pos - cameraPosition.xyz, nor);
		float dif = clamp(dot(nor, light1), 0.0, 1.0);
		float sh = softShadow(flatPos + light1 * 0.05, light1);
		col = vec3(0.55, 0.58, 0.62) * mix(0.25, 1.0, dif * sh);
	}

	return pow(col, vec3(0.4545));
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(colorImage);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec4 existing = imageLoad(colorImage, pixel);
	if (existing.a > 0.0) return;

	vec3 ro = cameraPosition.xyz;
	vec3 rd = pixelRayDirection(pixel, size);

	vec3 light1 = normalize(vec3(-0.8, -0.3, 0.4));

	float tmin = 0.001;
	float tmax = clampTmaxToPlanet(rd, 10000.0);

	int steps;
	float t = intersectScene(ro, rd, tmin, tmax, steps);
	// f1 = custom1 (showStepCount); heatmap skips shading/shadows
	vec3 col = (f1 > 0.5) ? stepCountColor(steps) : shadeHit(ro, rd, t, tmax, light1);

	bool isSky = (t > tmax);
	vec3 storePos;
	if (isSky)
	{
		// Direction only — splat reconstructs cam-relative infinity so translation is ignored.
		storePos = rd;
	}
	else
	{
		vec3 curvedHit = ro + rd * t;
		storePos = bool(customInt1) ? flatWorldPos(curvedHit) : curvedHit;
	}
	vec4 color = vec4(col, 1.0);

	// f2 = custom2 (showRecalcPixels): mark hole-fills this frame red on the image only;
	// SSBO keeps the real color so the next splat pass can restore non-hole pixels.
	vec4 display = (f2 > 0.5) ? vec4(1.0, 0.0, 0.0, 1.0) : color;
	imageStore(colorImage, pixel, display);

	uint index = uint(pixel.y * size.x + pixel.x);
	points[index].worldPos = vec4(storePos, isSky ? 0.0 : 1.0);
	points[index].color = color;
}
