//! #include "uniformsCompute.glsl"
//! #include "milkyWaySky.glsl"

// Ray-marched terrain + test objects for the SDF pointcloud demo.
// Terrain = domain-warped rolling hills plus ridged mountains (Musgrave-style multifractal),
// built on hashed gradient noise. Coordinates are ORKA Z-up (XY ground); the ground at the
// world origin is shifted to z = 0 so the test objects always sit on it.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform image2D colorImage;

struct Point
{
	vec4 worldPos; // planet: xyz=flat/world pos, w=1; sky: xyz=view dir, w=0
	vec4 color;
};

layout(std430, binding = 1) buffer PointCloud
{
	Point points[];
};

const float TERRAIN_FREQUENCY = 0.03;  // 1 / feature size in world units
const float TERRAIN_HEIGHT    = 14.0;  // world units
const int   MARCH_OCTAVES     = 8;
const int   NORMAL_OCTAVES    = 12;
const float SNOW_HEIGHT       = 7.0;   // world units above the origin ground
const vec3  SUN_LIGHT         = vec3(3.2, 2.8, 2.3);
const vec3  SKY_LIGHT         = vec3(0.25, 0.32, 0.45);
const vec3  BOUNCE_LIGHT      = vec3(0.12, 0.10, 0.08);
const int   MAX_MARCH_STEPS   = 512;
const int   SHADOW_STEPS      = 64;

// Height of the raw terrain at the world origin; set once per invocation in main().
float groundOffset = 0.0;

// Mooncrash planet curvature (terrain.vert / mooncrashVertexColor.vert)
float planetRadius()
{
	return pow(2.0, worldOffset.w);
}

// Horizontal arc distance in planet radii (dist >= 0)
float planetDist(vec3 rel, float R)
{
	return 1.5 * length(rel.xy) / R;
}

float planetFunc(float dist)
{
	return sqrt(1.0 - min(dist * dist, 1.0));
}

bool beyondHorizon(vec3 rel)
{
	return planetDist(rel, planetRadius()) > 1.0;
}

// Horizontal planet disc radius (matches beyondHorizon / Mooncrash 1.5 factor).
float planetHorizonRadius()
{
	return planetRadius() / 1.5;
}

// Clamp march distance to the planet disc so rays can't run out to infinity.
float clampTmaxToPlanet(vec3 rd, float tmax)
{
	float maxHoriz = planetHorizonRadius();
	float hs = length(rd.xy);
	if (hs > 1e-6)
		return min(tmax, 0.999 * maxHoriz / hs);
	// Straight up/down: no horizon in XY — keep a bounded sky distance.
	return min(tmax, planetRadius());
}

vec3 flatRelativeFromCurved(vec3 rel)
{
	float R    = planetRadius();
	float func = planetFunc(planetDist(rel, R));
	rel.z     -= (func - 1.0) * R;
	return rel;
}

vec3 flatWorldPos(vec3 worldPos)
{
	vec3 rel = worldPos - cameraPosition.xyz;
	if (beyondHorizon(rel)) return worldPos;
	return cameraPosition.xyz + flatRelativeFromCurved(rel);
}

void transformNormalToCurved(vec3 rel, inout vec3 normal)
{
	float R    = planetRadius();
	float func = planetFunc(planetDist(rel, R));
	vec3 newZ  = normalize(vec3(rel.xy * 2.0, func * R));
	vec3 newX  = normalize(cross(vec3(0.0, 1.0, 0.0), newZ));
	vec3 newY  = normalize(cross(newZ, newX));
	normal     = normal.x * newX + normal.y * newY + normal.z * newZ;
}

// Integer hash: Chris Wellons' "lowbias32" finalizer (public domain), seeded from both cell axes.
uint hashCell(ivec2 cell)
{
	uint h = uint(cell.x) * 0x9E3779B9u + uint(cell.y);
	h ^= h >> 16;
	h *= 0x7FEB352Du;
	h ^= h >> 15;
	h *= 0x846CA68Bu;
	h ^= h >> 16;
	return h;
}

// Unit gradient for a lattice point.
vec2 cellGradient(ivec2 cell)
{
	float angle = float(hashCell(cell)) * (6.28318530718 / 4294967296.0);
	return vec2(cos(angle), sin(angle));
}

// 2D gradient noise in roughly [-0.7, 0.7], quintic fade between lattice points.
float gradientNoise(vec2 position)
{
	ivec2 cell  = ivec2(floor(position));
	vec2  local = fract(position);
	vec2  fade  = local * local * local * (local * (local * 6.0 - 15.0) + 10.0);

	float bottomLeft  = dot(cellGradient(cell),                local);
	float bottomRight = dot(cellGradient(cell + ivec2(1, 0)),  local - vec2(1.0, 0.0));
	float topLeft     = dot(cellGradient(cell + ivec2(0, 1)),  local - vec2(0.0, 1.0));
	float topRight    = dot(cellGradient(cell + ivec2(1, 1)),  local - vec2(1.0, 1.0));

	float bottom = mix(bottomLeft, bottomRight, fade.x);
	float top    = mix(topLeft, topRight, fade.x);
	return mix(bottom, top, fade.y);
}

// Rotate each octave so lattice artifacts don't line up.
vec2 nextOctave(vec2 position)
{
	const mat2 rotation = mat2(0.866, 0.5, -0.5, 0.866); // 30 degrees
	return rotation * position * 2.07 + vec2(17.3, -9.1);
}

float rollingHills(vec2 position, int octaves)
{
	float height    = 0.0;
	float amplitude = 0.5;
	for (int i = 0; i < octaves; i++)
	{
		height    += amplitude * gradientNoise(position);
		amplitude *= 0.5;
		position   = nextOctave(position);
	}
	return height;
}

// Ridged multifractal: sharp crests, with each octave weighted by the previous one so detail
// gathers on the ridges and valleys stay smooth.
float ridgedMountains(vec2 position, int octaves)
{
	float height    = 0.0;
	float amplitude = 0.5;
	float weight    = 1.0;
	for (int i = 0; i < octaves; i++)
	{
		float ridge = 1.0 - abs(gradientNoise(position) * 1.4);
		ridge      *= ridge * weight;
		height     += amplitude * ridge;
		weight      = clamp(ridge * 1.6, 0.0, 1.0);
		amplitude  *= 0.45;
		position    = nextOctave(position);
	}
	return height;
}

float rawTerrainHeight(vec2 worldXY, int octaves)
{
	vec2 position = worldXY * TERRAIN_FREQUENCY;

	// Domain warp bends the features so they don't look grid-aligned.
	vec2 warp = vec2(gradientNoise(position * 0.5 + vec2(13.1, 7.7)),
	                 gradientNoise(position * 0.5 + vec2(-4.3, 21.9)));
	position += 0.8 * warp;

	float mountainMask = smoothstep(-0.2, 0.3, gradientNoise(position * 0.3 + vec2(41.0, -17.0)));
	float hills        = rollingHills(position, octaves);
	float mountains    = ridgedMountains(position * 0.8, octaves);

	return TERRAIN_HEIGHT * (0.35 * hills + mountainMask * 0.9 * mountains);
}

float terrainHeight(vec2 worldXY, int octaves)
{
	return rawTerrainHeight(worldXY, octaves) - groundOffset;
}

float sdSphere(vec3 p, vec3 center, float radius)
{
	return length(p - center) - radius;
}

float sdBox(vec3 p, vec3 b)
{
	vec3 q = abs(p) - b;
	return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float terrainSDF(vec3 p)
{
	return p.z - terrainHeight(p.xy, MARCH_OCTAVES);
}

float objectsSDF(vec3 p)
{
	return min(
		min(sdBox(p, vec3(1.0)), sdSphere(p, vec3(0.0, 3.0, 1.0), 1.0)),
		sdSphere(p, vec3(1.0, 3.0, 0.5), 1.0)
	) - 0.01;
}

float scene(vec3 p)
{
	return min(terrainSDF(p), objectsSDF(p));
}

float sceneCurved(vec3 worldPos)
{
	if (!bool(customInt1)) return scene(worldPos);

	vec3 rel = worldPos - cameraPosition.xyz;
	if (beyondHorizon(rel)) return 1000.0;
	return scene(flatWorldPos(worldPos));
}

float intersectScene(in vec3 ro, in vec3 rd, in float tmin, in float tmax, out int steps)
{
	float t = tmin;
	steps = 0;
	for (int i = 0; i < MAX_MARCH_STEPS; i++)
	{
		steps = i + 1;
		float h = sceneCurved(ro + t * rd);
		if (h < (0.001 * t) || t > tmax) break;
		t += 0.5 * h;
	}
	return t;
}

vec3 stepCountColor(int steps)
{
	float n = clamp(float(steps) / float(MAX_MARCH_STEPS), 0.0, 1.0);
	vec3 low  = vec3(0.05, 0.10, 0.85);
	vec3 mid  = vec3(0.10, 0.90, 0.35);
	vec3 high = vec3(0.95, 0.15, 0.05);
	vec3 col  = mix(low, mid, smoothstep(0.0, 0.5, n));
	col       = mix(col, high, smoothstep(0.5, 1.0, n));
	return pow(col, vec3(0.4545));
}

// 0 = fully shadowed, 1 = lit. Tracks how close the shadow ray passes to geometry
// relative to the distance travelled, which gives a soft penumbra.
float sunVisibility(vec3 origin, vec3 sunDirection)
{
	float visibility = 1.0;
	float travelled  = 0.05;
	for (int i = 0; i < SHADOW_STEPS; i++)
	{
		float gap = scene(origin + sunDirection * travelled);
		visibility     = min(visibility, 12.0 * gap / travelled);
		if (visibility < 0.001 || travelled > 4.0 * TERRAIN_HEIGHT) break;
		travelled += clamp(gap, 0.05, 2.0);
	}
	return smoothstep(0.0, 1.0, clamp(visibility, 0.0, 1.0));
}

vec3 calcTerrainNormal(vec3 pos, float t)
{
	float e = max(0.002 * t, 0.01);
	float dx = terrainHeight(pos.xy + vec2(e, 0.0), NORMAL_OCTAVES) - terrainHeight(pos.xy - vec2(e, 0.0), NORMAL_OCTAVES);
	float dy = terrainHeight(pos.xy + vec2(0.0, e), NORMAL_OCTAVES) - terrainHeight(pos.xy - vec2(0.0, e), NORMAL_OCTAVES);
	return normalize(vec3(-dx, -dy, 2.0 * e));
}

vec3 calcObjectNormal(in vec3 pos)
{
	const vec2 e = vec2(0.001, 0.0);
	return normalize(vec3(
		objectsSDF(pos + e.xyy) - objectsSDF(pos - e.xyy),
		objectsSDF(pos + e.yxy) - objectsSDF(pos - e.yxy),
		objectsSDF(pos + e.yyx) - objectsSDF(pos - e.yyx)
	));
}

vec3 pixelRayDirection(ivec2 pixel, ivec2 size)
{
	vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;

	mat4 invVP = inverse(pMatrix * vMatrix);
	vec4 nearH = invVP * vec4(ndc, 0.0, 1.0);
	vec4 farH  = invVP * vec4(ndc, 1.0, 1.0);
	return normalize(farH.xyz / farH.w - nearH.xyz / nearH.w);
}

// Albedo from slope and height: grass on flats, dirt then rock on slopes, snow on high flats.
vec3 terrainAlbedo(vec3 flatPos, vec3 normal)
{
	const vec3 grass = vec3(0.13, 0.17, 0.06);
	const vec3 dirt  = vec3(0.16, 0.12, 0.08);
	const vec3 rock  = vec3(0.22, 0.20, 0.19);
	const vec3 snow  = vec3(0.85, 0.88, 0.92);

	float slope     = 1.0 - normal.z;
	float variation = 0.5 + 0.5 * gradientNoise(flatPos.xy * 0.8);

	vec3 albedo = mix(grass, dirt, smoothstep(0.12, 0.3, slope + 0.1 * variation));
	albedo      = mix(albedo, rock, smoothstep(0.3, 0.55, slope));

	float snowLine = SNOW_HEIGHT + 2.0 * gradientNoise(flatPos.xy * 0.15);
	float snowMask = smoothstep(snowLine, snowLine + 1.5, flatPos.z) * smoothstep(0.55, 0.25, slope);
	albedo         = mix(albedo, snow, snowMask);

	return albedo * mix(0.8, 1.1, variation);
}

vec3 shadeHit(in vec3 ro, in vec3 rd, float t, float tmax, vec3 sunDirection)
{
	if (t > tmax)
		return milkyWaySky(rd);

	vec3 pos     = ro + t * rd;
	vec3 flatPos = bool(customInt1) ? flatWorldPos(pos) : pos;
	bool hitTerrain = terrainSDF(flatPos) <= objectsSDF(flatPos);

	vec3 normal;
	vec3 albedo;
	if (hitTerrain)
	{
		normal = calcTerrainNormal(flatPos, t);
		albedo = terrainAlbedo(flatPos, normal);
	}
	else
	{
		normal = calcObjectNormal(flatPos);
		albedo = vec3(0.18, 0.19, 0.21);
	}
	if (bool(customInt1)) transformNormalToCurved(pos - cameraPosition.xyz, normal);

	float direct = clamp(dot(normal, sunDirection), 0.0, 1.0);
	if (direct > 0.0) direct *= sunVisibility(flatPos + normal * 0.02, sunDirection);
	float skyAmount    = 0.5 + 0.5 * normal.z;
	float bounceAmount = clamp(dot(normal, normalize(vec3(-sunDirection.xy, 0.0))), 0.0, 1.0);

	vec3 lighting = direct * SUN_LIGHT + skyAmount * SKY_LIGHT + bounceAmount * BOUNCE_LIGHT;
	return pow(albedo * lighting, vec3(0.4545));
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(colorImage);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec4 existing = imageLoad(colorImage, pixel);
	if (existing.a > 0.0) return;

	groundOffset = rawTerrainHeight(vec2(0.0), MARCH_OCTAVES);

	vec3 ro = cameraPosition.xyz;
	vec3 rd = pixelRayDirection(pixel, size);

	vec3 sunDirection = normalize(vec3(-0.8, -0.3, 0.4));

	float tmin = 0.001;
	float tmax = clampTmaxToPlanet(rd, 10000.0);

	int steps;
	float t = intersectScene(ro, rd, tmin, tmax, steps);
	// f1 = custom1 (showStepCount); heatmap skips shading/shadows
	vec3 col = (f1 > 0.5) ? stepCountColor(steps) : shadeHit(ro, rd, t, tmax, sunDirection);

	bool isSky = (t > tmax);
	vec3 storePos;
	if (isSky)
	{
		// Direction only — splat reconstructs cam-relative infinity so translation is ignored.
		storePos = rd;
	}
	else
	{
		vec3 curvedHit = ro + rd * t;
		storePos = bool(customInt1) ? flatWorldPos(curvedHit) : curvedHit;
	}
	vec4 color = vec4(col, 1.0);

	// f2 = custom2 (showRecalcPixels): mark hole-fills this frame red on the image only;
	// SSBO keeps the real color so the next splat pass can restore non-hole pixels.
	vec4 display = (f2 > 0.5) ? vec4(1.0, 0.0, 0.0, 1.0) : color;
	imageStore(colorImage, pixel, display);

	uint index = uint(pixel.y * size.x + pixel.x);
	points[index].worldPos = vec4(storePos, isSky ? 0.0 : 1.0);
	points[index].color = color;
}
